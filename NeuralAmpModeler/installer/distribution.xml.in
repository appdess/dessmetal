<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
  <title>DessMetal @VERSION@</title>
  <welcome file="intro.rtf" mime-type="application/rtf"/>
  <readme file="readme-mac.rtf" mime-type="application/rtf"/>
  <license file="license.rtf" mime-type="application/rtf"/>
  <options require-scripts="false" customize="always" hostArchitectures="arm64,x86_64"/>
  <choices-outline>
    <line choice="com.AlexanderDess.pkg.DessMetal.app"/>
    <line choice="com.AlexanderDess.pkg.DessMetal.au"/>
    <line choice="com.AlexanderDess.pkg.DessMetal.vst3"/>
  </choices-outline>
  <choice id="com.AlexanderDess.pkg.DessMetal.app" visible="true" start_selected="true" title="Standalone application">
    <pkg-ref id="com.AlexanderDess.pkg.DessMetal.app"/>
  </choice>
  <choice id="com.AlexanderDess.pkg.DessMetal.au" visible="true" start_selected="true" title="Audio Unit plug-in (Logic Pro)">
    <pkg-ref id="com.AlexanderDess.pkg.DessMetal.au"/>
  </choice>
  <choice id="com.AlexanderDess.pkg.DessMetal.vst3" visible="true" start_selected="true" title="VST3 plug-in">
    <pkg-ref id="com.AlexanderDess.pkg.DessMetal.vst3"/>
  </choice>
  <pkg-ref id="com.AlexanderDess.pkg.DessMetal.app" version="@VERSION@" auth="Root">DessMetal_APP.pkg</pkg-ref>
  <pkg-ref id="com.AlexanderDess.pkg.DessMetal.au" version="@VERSION@" auth="Root">DessMetal_AU.pkg</pkg-ref>
  <pkg-ref id="com.AlexanderDess.pkg.DessMetal.vst3" version="@VERSION@" auth="Root">DessMetal_VST3.pkg</pkg-ref>
</installer-gui-script>
